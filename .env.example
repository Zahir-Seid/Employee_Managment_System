# Copy to .env and edit. Read by the backend container (docker compose).
# Required when DEBUG=False: DJANGO_SECRET_KEY, ALLOWED_HOSTS, DB_PASSWORD.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
# Hostnames users reach the site on, comma-separated (no scheme or port).
ALLOWED_HOSTS=jeems.example.org
# Public origin(s) with scheme; needed for the Django admin login over HTTPS.
CSRF_TRUSTED_ORIGINS=https://jeems.example.org
# Public URL of the site, used for links in notification emails.
FRONTEND_URL=https://jeems.example.org
HTTP_PORT=80

# PostgreSQL runs in the "db" container (data kept in the postgres_data volume).
# The database, user and password are created the FIRST time the volume is
# created; changing DB_PASSWORD later does not change an existing database.
DB_NAME=jeems_db
DB_USER=jeems
# <<< CHANGE: choose a password. Avoid the characters  $  #  "  ' and spaces.
DB_PASSWORD=
# docker-compose.yml connects the backend to the "db" service on port 5432, so
# DB_HOST and DB_PORT are set there. They only matter for running outside Docker.
DB_HOST=db
DB_PORT=5432
# disable, allow, prefer (default), require, verify-ca or verify-full
DB_SSLMODE=prefer

TIME_ZONE=UTC
JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=7
LOG_LEVEL=INFO

# HTTPS is terminated in front of the containers (load balancer / reverse proxy
# that sends X-Forwarded-Proto). Leave these False only for plain-HTTP testing.
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
# Seconds; start small (e.g. 3600) and raise once HTTPS is confirmed working.
SECURE_HSTS_SECONDS=0

# Outgoing email (SMTP). Without EMAIL_HOST in production, mail is not delivered.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EMS <noreply@ee.org>
# COMMS_TEAM_EMAIL=communications@ee.org
