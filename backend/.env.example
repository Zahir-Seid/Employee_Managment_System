DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection — create this database/user first (or point these
# at an existing Postgres instance/server).
DB_NAME=jeems
DB_USER=jeems
DB_PASSWORD=jeems
DB_HOST=localhost
DB_PORT=5432

TIME_ZONE=UTC

JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# EMAIL_BACKEND is deliberately left unset here: settings.py auto-selects
# the console backend (prints emails to this terminal instead of trying
# real SMTP) whenever DEBUG=True and EMAIL_HOST_USER is blank, which is
# exactly this local setup. Setting EMAIL_BACKEND explicitly would
# override that and force real SMTP against the placeholder host below,
# which doesn't exist — every send would fail silently. Once you have
# real credentials, fill in EMAIL_HOST_USER/EMAIL_HOST_PASSWORD below and
# it'll switch to actually sending, no need to touch EMAIL_BACKEND.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EMS <noreply@ee.org>
COMMS_TEAM_EMAIL=communications@ee.org

# Item 19: base URL of the deployed frontend (no trailing slash), used to
# build clickable links in notification emails. Leave blank for local dev.
FRONTEND_URL=

# Fixed technical upload ceilings, read once at startup. The limits users
# actually see — max photo size and photos per report — are configured in
# the app under Configuration > System Settings, and must stay below these.
HARD_MAX_PHOTO_SIZE_MB=25
HARD_MAX_PHOTOS_PER_EVENT=30

LOG_LEVEL=INFO
# Local development: leave this False. Only set to True in a real
# deployment that actually has an SSL certificate configured — otherwise
# Django will force HTTPS redirects with nothing able to handle them,
# which looks like the backend is broken.
SECURE_SSL_REDIRECT=False

# Rate-limit identity (security review finding #3). TRUSTED_PROXY_COUNT=1
# tells DRF the last X-Forwarded-For hop is trustworthy (the shipped
# nginx configs set it); spoofed client prefixes are ignored. Set it to 0
# ONLY if Django is exposed directly with no proxy in front — clients
# could otherwise forge XFF. CACHE_BACKEND=filebased makes gunicorn's
# workers share throttle counters through one directory; local
# development without gunicorn can leave it empty (per-process locmem).
TRUSTED_PROXY_COUNT=1
CACHE_BACKEND=
CACHE_LOCATION=/tmp/ems-cache
