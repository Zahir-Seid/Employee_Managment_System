# Copy this file to backend/.env on the server, then edit every line marked
#   <<< CHANGE
# Lines without that marker can stay as they are.

DEBUG=False

# <<< CHANGE: a long random string. Generate one on the server with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=

# <<< CHANGE: your domain, no http:// and no port (several: comma-separated)
ALLOWED_HOSTS=jeems.example.org

# <<< CHANGE: your domain WITH https://
CSRF_TRUSTED_ORIGINS=https://jeems.example.org
FRONTEND_URL=https://jeems.example.org

# PostgreSQL on the same server.
DB_NAME=jeems
DB_USER=jeems
# <<< CHANGE: the password you gave the database user in step 2 of DEPLOY.md.
# It must be identical in both places.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Turn these on once HTTPS works (certbot, step 8 of DEPLOY.md).
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
# 0 = off. After you confirm HTTPS works, use 31536000 (one year).
SECURE_HSTS_SECONDS=0

TIME_ZONE=Africa/Addis_Ababa
JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=7
LOG_LEVEL=INFO

# <<< CHANGE: your real SMTP server details. Without EMAIL_HOST_USER and
# EMAIL_HOST_PASSWORD no email is delivered (notifications, registration codes).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=EMS <noreply@ee.org>
COMMS_TEAM_EMAIL=communications@ee.org

MAX_PHOTO_SIZE_MB=5
MAX_PHOTOS_PER_EVENT=5

# Rate-limit identity (security review finding #3). deploy/nginx-jeems.conf
# appends the client address as the last X-Forwarded-For hop, so 1 is
# correct there; set 0 if you ever expose Django without that proxy.
# On the systemd path gunicorn also has multiple workers — point the
# throttle cache at filebased (or add django-redis for multiple hosts).
TRUSTED_PROXY_COUNT=1
CACHE_BACKEND=filebased
CACHE_LOCATION=/tmp/ems-cache
